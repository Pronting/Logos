---
import { i18n } from "astro:config/client";
import { profileConfig } from '@/config';
import { getSiteTotals } from '@utils/content-utils';
import i18nit from '@i18n/translation';

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const { articleCount: totalArticles } = await getSiteTotals(currentLang);

// 计算运行时间
const startDate = new Date(profileConfig.startYear, 0, 1);
const now = new Date();
const diffMs = now.getTime() - startDate.getTime();
const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
const years = Math.floor(totalDays / 365);
const days = totalDays % 365;

const runningText = years > 0
  ? t("siteStats.runningYears", { years: String(years), days: String(days) })
  : t("siteStats.runningDays", { days: String(totalDays) });
---

<div class="site-stats text-center py-4 text-xs text-[var(--text-color-50)]">
  <span>{t("siteStats.articles", { count: String(totalArticles) })}</span>
  <span class="mx-2">·</span>
  <span>{runningText}</span>
</div>

<style>
  .site-stats {
    font-family: "EB Garamond", cursive !important;
  }
</style>
