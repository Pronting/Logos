---
import { blogCoverUrl} from '@utils/url-utils'
import PostCard from '@components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

const { page, urlPrefix = "/blog/" } = Astro.props;

---
{page.data.map((entry: CollectionEntry<"blog"> | CollectionEntry<"bookReview">) => (
        <PostCard
            entry={entry}
            title={entry.data.title}
            description={entry.data.description}
            image={blogCoverUrl(entry.data.image, entry.id)}
            pubDate={entry.data.pubDate}
            url={entry.id}
            fallback={entry.isFallback ?? false}
            urlPrefix={urlPrefix}>
        </PostCard>
))}