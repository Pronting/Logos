---
import "@styles/global.css"
import { Icon } from "astro-icon/components"
import { profileConfig } from "@/config"
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation"

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const { avatar, name, description, motto, links = [] } = profileConfig;

// Resolve avatar URL. Supports three forms in `profileConfig.avatar`:
//   1. http(s):// or data: URL -> passed through as-is
//   2. "/..." path -> treated as a /public asset
//   3. relative path like "assets/Motues.jpg" -> looked up via
//      import.meta.glob against /src so Vite emits the hashed asset URL
const isAbsoluteOrData = (s: string) =>
    /^([a-z]+:)?\/\//i.test(s) || s.startsWith("data:");

// Eager glob: each key is the source path (relative to this file), each
// value is the asset URL Vite/Astro will emit at build time.
const srcAssetMap = import.meta.glob<string>(
    '../assets/*.{jpg,jpeg,png,webp,gif,svg,ico}',
    { eager: true, query: '?url', import: 'default' }
);

const avatarSrc = isAbsoluteOrData(avatar)
    ? avatar
    : avatar.startsWith("/")
        ? avatar
        : (srcAssetMap[`../${avatar}`] ?? `/${avatar}`);
---

<aside
    data-aos="fade-left"
    data-aos-delay="100"
    class="profile-card group block w-full max-w-[280px] mx-auto my-6 p-6 rounded-xl shadow border border-[var(--button-border-color)] bg-[var(--bg-color)] text-[var(--text-color)] transition-all duration-300 hover:shadow-lg hover:border-[var(--link-color)]"
    aria-label={t("profileCard.title")}
>
    <!-- Avatar -->
    <div class="flex justify-center mb-4">
        <div class="avatar-wrap relative w-24 h-24 rounded-full overflow-hidden ring-2 ring-[var(--button-border-color)] transition-all duration-300 group-hover:ring-[var(--link-color)]">
            <img
                src={avatarSrc}
                alt={name}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://www.gravatar.com/avatar/?d=mp';"
            />
        </div>
    </div>

    <!-- Name & motto -->
    <div class="text-center mb-4">
        <h2 class="text-lg font-bold tracking-wide">{name}</h2>
        {motto && (
            <p class="mt-1 text-sm italic text-[var(--text-color-70)]">
                "{motto}"
            </p>
        )}
        {description && (
            <p class="mt-1 text-xs text-[var(--text-color-70)] opacity-80">
                {description}
            </p>
        )}
    </div>

    <!-- Divider -->
    <div class="border-t border-[var(--button-border-color)] my-3"></div>

    <!-- Contact links -->
    {links.length > 0 && (
        <div>
            <p class="text-xs font-semibold text-[var(--text-color-70)] uppercase tracking-wider mb-2">
                {t("profileCard.contact")}
            </p>
            <ul class="space-y-1.5">
                {links.map((link) => (
                    <li>
                        {link.copyable ? (
                            <button
                                type="button"
                                class="profile-link w-full flex items-center gap-2 px-2 py-1.5 rounded-md text-sm text-[var(--text-color)] hover:bg-[var(--button-hover-color)] active:scale-[0.98] transition-all duration-200"
                                data-copy-value={link.url}
                                data-copy-success={t("profileCard.copySuccess")}
                                data-copy-failed={t("profileCard.copyFailed")}
                                aria-label={`${t("profileCard.copy")} ${link.name}`}
                            >
                                <Icon name={link.icon} class="w-4 h-4 shrink-0" style={link.color ? `color:${link.color}` : undefined} />
                                <span class="truncate">{link.name}</span>
                                <Icon name="fa6-solid:copy" class="w-3 h-3 ml-auto opacity-50 shrink-0" />
                            </button>
                        ) : (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="profile-link w-full flex items-center gap-2 px-2 py-1.5 rounded-md text-sm text-[var(--text-color)] hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)] transition-all duration-200"
                            >
                                <Icon name={link.icon} class="w-4 h-4 shrink-0" style={link.color ? `color:${link.color}` : undefined} />
                                <span class="truncate">{link.name}</span>
                                <Icon name="fa6-solid:arrow-up-right-from-square" class="w-3 h-3 ml-auto opacity-50 shrink-0" />
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        </div>
    )}
</aside>

<style>
    .profile-card :global(.profile-link:hover) :global(svg) {
        transform: scale(1.1);
    }
    .profile-card :global(.profile-link svg) {
        transition: transform 0.2s ease;
    }
</style>

<script>
    function initCopyButtons() {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.profile-link[data-copy-value]');
        if (buttons.length === 0) return;

        buttons.forEach((btn) => {
            if (btn.dataset.bound === 'true') return;
            btn.dataset.bound = 'true';

            btn.addEventListener('click', async () => {
                const value = btn.dataset.copyValue ?? '';
                const successMsg = btn.dataset.copySuccess ?? 'Copied';
                const failedMsg = btn.dataset.copyFailed ?? 'Copy failed';

                try {
                    if (navigator.clipboard && window.isSecureContext) {
                        await navigator.clipboard.writeText(value);
                    } else {
                        // Fallback for non-secure contexts
                        const ta = document.createElement('textarea');
                        ta.value = value;
                        ta.style.position = 'fixed';
                        ta.style.opacity = '0';
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                    }
                    flashFeedback(btn, successMsg);
                } catch (err) {
                    console.error('Copy failed:', err);
                    flashFeedback(btn, failedMsg);
                }
            });
        });
    }

    function flashFeedback(btn: HTMLButtonElement, msg: string) {
        const original = btn.innerHTML;
        btn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0 text-green-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="truncate">${msg}</span>
        `;
        btn.disabled = true;
        setTimeout(() => {
            btn.innerHTML = original;
            btn.disabled = false;
        }, 1500);
    }

    document.addEventListener('astro:page-load', initCopyButtons);
</script>
