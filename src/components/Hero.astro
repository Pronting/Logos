---
import "@styles/global.css"
import { heroConfig } from "@/config/hero"

const { greeting, name, motto, tags } = heroConfig;
const titleChars = [...greeting, ...name];
---

<div
    class="hero-section text-center pt-16 pb-8 max-w-[var(--page-width)] mx-auto md:mt-0 mt-24 px-4"
    data-aos="fade-up"
>
    <!-- 大字主标题：逐字淡入 -->
    <h1
        class="hero-title text-[var(--text-color)] font-extrabold leading-tight tracking-tight mb-4"
        style="font-size: clamp(2.5rem, 6vw, 5rem);"
    >
        {titleChars.map((char, i) => (
            <span
                class="hero-char"
                style={`animation: heroFadeIn 0.5s ease-out both; animation-delay: ${i * 60}ms;`}
            >
                {char === " " ? " " : char}
            </span>
        ))}
    </h1>

    <!-- 座右铭 -->
    <p
        class="hero-motto text-[var(--text-color-70)] mb-6"
        style="font-size: clamp(1rem, 2.5vw, 1.5rem);"
    >
        <span
            class="hero-motto-text inline-block"
            style="border-right: 2px solid var(--link-color);
                   animation: heroTypewriter 2s steps(30, end) 1s both,
                              heroBlinkCaret 0.75s step-end infinite;"
        >
            {motto}
        </span>
    </p>

    <!-- 标签行 -->
    <div class="hero-tags flex flex-wrap justify-center gap-3" data-aos="fade-up" data-aos-delay="400">
        {tags.map((tag) => (
            <span
                class="inline-block px-4 py-1.5 rounded-full text-sm font-medium
                       bg-[var(--button-hover-color)] text-[var(--text-color-70)]
                       border border-[var(--button-border-color)]
                       hover:border-[var(--link-color)] hover:text-[var(--link-color)]
                       transition-all duration-300"
            >
                {tag}
            </span>
        ))}
    </div>
</div>

<!-- is:global ensures keyframe names are NOT scoped, so inline style="animation: heroFadeIn" matches -->
<style is:global>
    .hero-char {
        display: inline-block;
        opacity: 0;
    }

    @keyframes heroFadeIn {
        0% {
            opacity: 0;
            transform: translateY(0.8em);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes heroTypewriter {
        from {
            width: 0;
        }
        to {
            width: 100%;
        }
    }

    @keyframes heroBlinkCaret {
        from,
        to {
            border-color: transparent;
        }
        50% {
            border-color: var(--link-color);
        }
    }
</style>

<script>
    function resetHeroAnimation() {
        const chars = document.querySelectorAll<HTMLElement>('.hero-char');
        const motto = document.querySelector<HTMLElement>('.hero-motto-text');

        chars.forEach((el) => {
            el.style.animation = 'none';
            void el.offsetHeight;
            el.style.animation = '';
        });

        if (motto) {
            motto.style.animation = 'none';
            void motto.offsetHeight;
            motto.style.animation = '';
        }
    }

    document.addEventListener('astro:page-load', resetHeroAnimation);
</script>
