---
import "@styles/global.css"
import { heroConfig } from "@/config/hero"

const { greeting, name, motto, tags } = heroConfig;
---

<div
    class="hero-section text-center pt-16 pb-8 max-w-[var(--page-width)] mx-auto md:mt-0 mt-24 px-4"
    data-aos="fade-up"
    data-aos-duration="800"
>
    <!-- 大字主标题 -->
    <h1
        class="text-[var(--text-color)] font-extrabold leading-tight tracking-tight mb-4"
        style="font-size: clamp(2.5rem, 6vw, 5rem);"
    >
        {greeting} {name}
    </h1>

    <!-- 座右铭：JS 打字机 -->
    <p class="mb-6" style="font-size: clamp(1rem, 2.5vw, 1.5rem);">
        <span
            id="hero-motto"
            class="text-[var(--text-color-70)]"
            data-motto={motto}
        ></span>
        <span
            id="hero-cursor"
            class="inline-block w-[2px] h-[1em] bg-[var(--link-color)] align-text-bottom ml-0.5"
            style="animation: blink 0.6s step-end infinite;"
        ></span>
    </p>

    <!-- 标签行 -->
    <div class="flex flex-wrap justify-center gap-3" data-aos="fade-up" data-aos-delay="400">
        {tags.map((tag) => (
            <span
                class="inline-block px-4 py-1.5 rounded-full text-sm font-medium
                       bg-[var(--button-hover-color)] text-[var(--text-color-70)]
                       border border-[var(--button-border-color)]
                       hover:border-[var(--link-color)] hover:text-[var(--link-color)]
                       transition-all duration-300"
            >
                {tag}
            </span>
        ))}
    </div>
</div>

<style>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>

<script>
    function runTypewriter() {
        const el = document.getElementById('hero-motto');
        const cursor = document.getElementById('hero-cursor');
        if (!el || !cursor) return;

        const text = el.dataset.motto || '';
        if (el.textContent && el.textContent.length >= text.length) return; // already typed

        el.textContent = '';
        cursor.style.display = 'inline-block';

        let i = 0;
        const speed = 100; // ms per character

        function typeNext() {
            if (i < text.length) {
                el.textContent += text[i];
                i++;
                setTimeout(typeNext, speed);
            } else {
                // Keep cursor blinking after typing completes
            }
        }

        // Small delay so the AOS fade-up settles first
        setTimeout(typeNext, 600);
    }

    document.addEventListener('astro:page-load', runTypewriter);
</script>
