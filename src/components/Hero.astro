---
import "@styles/global.css"
import { heroConfig } from "@/config/hero"

const { greeting, name, motto, tags } = heroConfig;
// motto is now string[] — passed as JSON to data-mottos
---

<div
    class="hero-section text-center pt-16 pb-8 max-w-[var(--page-width)] mx-auto md:mt-0 mt-24 px-4"
    data-aos="fade-up"
    data-aos-duration="800"
>
    <!-- 大字主标题 -->
    <h1
        class="text-[var(--text-color)] font-extrabold leading-tight tracking-tight mb-4"
        style="font-size: clamp(2.5rem, 6vw, 5rem);"
    >
        {greeting} {name}
    </h1>

    <!-- 座右铭：JS 打字机 -->
    <p class="mb-6" style="font-size: clamp(1rem, 2.5vw, 1.5rem);">
        <span
            id="hero-motto"
            class="text-[var(--text-color-70)]"
            data-mottos={JSON.stringify(motto)}
        ></span>
        <span
            id="hero-cursor"
            class="inline-block w-[2px] h-[1em] bg-[var(--link-color)] align-text-bottom ml-0.5"
            style="animation: blink 0.6s step-end infinite;"
        ></span>
    </p>

    <!-- 标签行 -->
    <div class="flex flex-wrap justify-center gap-3" data-aos="fade-up" data-aos-delay="400">
        {tags.map((tag) => (
            <span
                class="inline-block px-4 py-1.5 rounded-full text-sm font-medium
                       bg-[var(--button-hover-color)] text-[var(--text-color-70)]
                       border border-[var(--button-border-color)]
                       hover:border-[var(--link-color)] hover:text-[var(--link-color)]
                       transition-all duration-300"
            >
                {tag}
            </span>
        ))}
    </div>
</div>

<style>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>

<script>
    function runTypewriter() {
        const el = document.getElementById('hero-motto');
        const cursor = document.getElementById('hero-cursor');
        if (!el || !cursor) return;

        const mottos: string[] = JSON.parse(el.dataset.mottos || '[]');
        if (mottos.length === 0) return;

        el.textContent = '';
        cursor.style.display = 'inline-block';

        const TYPE_SPEED = 100;      // ms per character when typing
        const BACK_SPEED = 50;       // ms per character when deleting
        const PAUSE_AFTER_TYPE = 2000; // pause 2s after typing completes
        const PAUSE_AFTER_DELETE = 300; // brief pause after deletion

        let mottoIndex = 0;

        function typeText(text: string, onComplete: () => void) {
            let i = 0;
            function typeNext() {
                if (i < text.length) {
                    el!.textContent += text[i];
                    i++;
                    setTimeout(typeNext, TYPE_SPEED);
                } else {
                    setTimeout(onComplete, PAUSE_AFTER_TYPE);
                }
            }
            typeNext();
        }

        function deleteText(onComplete: () => void) {
            function deleteNext() {
                const current = el!.textContent || '';
                if (current.length > 0) {
                    el!.textContent = current.slice(0, -1);
                    setTimeout(deleteNext, BACK_SPEED);
                } else {
                    setTimeout(onComplete, PAUSE_AFTER_DELETE);
                }
            }
            deleteNext();
        }

        function loop() {
            const text = mottos[mottoIndex];
            typeText(text, () => {
                deleteText(() => {
                    mottoIndex = (mottoIndex + 1) % mottos.length;
                    loop();
                });
            });
        }

        // Small delay so the AOS fade-up settles first
        setTimeout(loop, 600);
    }

    document.addEventListener('astro:page-load', runTypewriter);
</script>
